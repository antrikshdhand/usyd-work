t.seq <- seq(from=0, to=2, length.out=10)
t.seq
t.seq <- seq(from=0, to=2, length.out=10)
head(t.seq)
# d) Plot the empirical MGF and the analytical MGF
plot(t.seq, MGF_e(t.seq, X), main="Exponential MGF", xlab='t', ylab='',
type='l')
MGF_a <- function(t)
{
vec <- c()
for (i in 1:length(t))
{
vec[i] <- lambda/(lambda - t[i])
}
return(vec)
}
MGF_e <- function(t, x)
{
vec <- c()
for (i in 1:length(t))
{
vec[i] <- mean(exp(t[i] * x))
}
return(vec)
}
# d) Plot the empirical MGF and the analytical MGF
plot(t.seq, MGF_e(t.seq, X), main="Exponential MGF", xlab='t', ylab='',
type='l')
lines(t.seq, MGF_a(t.seq), type='p', col='red')
legend("topleft", legend=c("Analytical MGF", "Empirical MGF"),
lty=c(1,1), col=c("red", "black"))
# Q2
r <- 10000
n <- 50
Xbar <- rep(0, r)
for (i in 1:r)
{
Xbar[i] <- mean(runif(n, 0, 1))
}
# Theoretical values: as X_1, X_2, ..., X_50 are idd U(0, 1):
### E(Xbar) = E(X_1) = 1/2
### Var(X_bar) = Var(X_1)/n = 1/(12*n)
obs <- c(mean(Xbar), var(Xbar))
theo <- c(1/2, 1/(12*n))
answer = cbind(obs, theo)
rownames(answer) = c("mean", "var")
# Theoretical values: as X_1, X_2, ..., X_50 are idd U(0, 1):
### E(Xbar) = E(X_1) = 1/2
