r <- 10000
n <- c(2, 4, 8, 16, 32, 64)
sm <- rep(0, r)
par(mfrow=c(3, 2))
for (j in n)
{
for (i in 1:r)
{
x <- sample(1:6, j, replace=TRUE)
sm[i] <- mean(x)
}
plot(table(sm)/r, xlab="values", ylab="density", main=paste("n = ", j))
}
