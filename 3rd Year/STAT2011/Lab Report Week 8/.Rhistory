knitr::opts_chunk$set(echo = TRUE)
set.seed(1904)
# a)
m <- 10
n <- 20
p <- 1/3
# 100 simulations
B <- 100
X <- rbinom(B, m, p)
Y <- rbinom(B, n, p)
W <- X + Y
table(W)
# 10,000 simulations
B <- 10000
X <- rbinom(B, m, p)
Y <- rbinom(B, n, p)
W <- X + Y
table(W)
Tab = table(W)
W.obs = as.numeric(names(Tab))
P.obs = as.numeric(Tab/B)
plot(W.obs - 0.1, P.obs, type='h',
xlab = "Observed values of W = X + Y",
ylab = "Relative frequencies")
points(0:(m+n), dbinom(0:(m+n), m + n, p=1/3), type='h', col=2)
